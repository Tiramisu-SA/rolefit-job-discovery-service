# REST API for the web frontend (3000 = frontend, 3001 = Candidate Profile REST)
PORT=3002
# Web frontend origin allowed by CORS
CORS_ORIGIN=http://localhost:3000

# Upstream gRPC services (read-only callers; no database access from here)
CANDIDATE_PROFILE_GRPC_URL=localhost:50051
JOB_POSTING_GRPC_URL=localhost:50052
GRPC_DEADLINE_MS=5000

# template (default, no network) or gemini. gemini needs AI_API_KEY and AI_MODEL (from AI Studio).
# On a Gemini error or an ungrounded answer the service falls back to the template.
AI_PROVIDER=template
AI_API_KEY=
AI_MODEL=
